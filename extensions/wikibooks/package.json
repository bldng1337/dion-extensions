				"es.wikibooks.org",
				"it.wikibooks.org",
				"pt.wikibooks.org",
				"ru.wikibooks.org",
				"zh.wikibooks.org",
				"ja.wikibooks.org",
				"upload.wikimedia.org",
				"thumb.wikimedia.org"
			]
		}
	],
	"authors": [
		"bldng1337"
	],
	"license": "ISC",
	"id": "fa3388ad-a4fa-4b57-81fa-1a88fd002ac5",
