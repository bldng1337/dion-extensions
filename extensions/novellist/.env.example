# Credentials for the Novellist live-API tests (src/session.test.ts).
#
# The extension itself never reads these — they only unlock the optional
# "Novellist live API" test block. Without them (or with an expired access
# token) those tests skip themselves; everything else still runs.
#
# Copy this file to `.env` next to it (bun loads .env automatically) and fill
# in the values. `.env` is gitignored — never commit it.
#
# Easiest fill-in: let the sync script write .env for you from a browser
# cookie export of your www.novellist.co session (JSON array, e.g. from an
# "EditThisCookie"-style export):
#
#   bun run sync-cookies                 # reads <repo-root>/cookies
#   bun run sync-cookies my-export.json  # or an explicit path
#
# It joins/decodes the chunked novellist.* session cookies, refreshes the
# token through Supabase when expired, and writes all values below.
#
# Field reference:
# - NOVELLIST_ACCESS_TOKEN: Bearer JWT for the Novellist backend API
#   (~7 day expiry). Expired tokens are detected by the tests, which then
#   skip until you refresh.
# - NOVELLIST_REFRESH_TOKEN: Supabase refresh token for that session;
#   sync-cookies uses it to mint a fresh access token. Refresh tokens
#   rotate, so refreshing may log the browser session out.
# - NOVELLIST_SUPABASE_ANON_KEY: public anon key of Novellist's Supabase
#   project (shipped in their own web bundle, safe to keep — prefilled).
# - NOVELLIST_USER_ID: your Supabase user id (informational).
# - NOVELLIST_EMAIL: your Novellist login email (informational).

NOVELLIST_ACCESS_TOKEN=
NOVELLIST_REFRESH_TOKEN=
NOVELLIST_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inlpb25yc3VsdnZwZm16bWJtYW1pIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MTk5ODg0MTMsImV4cCI6MjAzNTU2NDQxM30.EW3C9NhuFu6TvZuYJ8B29HqeW35hH3BujR0sGRa9Ej0
NOVELLIST_USER_ID=
NOVELLIST_EMAIL=
