{
	"name": "novellist",
	"version": "1.0.0",
	"desc": "Bind Dion entries to Novellist and track your reading progress.",
	"icon": "https://www.novellist.co/nl-inverted-logo.png",
	"tags": [
		"novellist",
		"tracking",
		"novels",
		"books"
	],
	"lang": [
		"en"
	],
	"nsfw": false,
	"url": "https://www.novellist.co/",
	"extension_type": [
		{
			"type": "EntryProcessor",
			"trigger_map_entry": true,
			"trigger_on_entry_activity": true
		}
	],
	"media_type": [
		"Book",
		"Unknown"
	],
	"permissions": [
		{
			"type": "Network",
			"domains": [
				"novellist-be-960019704910.asia-east1.run.app",
				"yionrsulvvpfmzmbmami.supabase.co",
				"bucket.novellist.co",
				"placehold.co"
			]
		}
	],
	"authors": [
		"bldng1337"
	],
	"license": "ISC",
	"api_version": "*",
	"id": "4aadfcc0-f981-4256-971b-e378bb47253b",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun test",
		"lint": "bunx biome check",
		"format": "bunx biome format --write",
		"build": "bunx dion-bundle",
		"check-types": "bunx tsc --noEmit",
		"sync-cookies": "bun scripts/sync-cookies.ts"
	},
	"dependencies": {
		"@dion-js/runtime-lib": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@biomejs/biome": "catalog:",
		"@dion-js/runtime": "catalog:",
		"@dion-js/runtime-types": "catalog:",
		"@dion-js/extension-types": "catalog:",
		"@dion-js/config": "catalog:",
		"typescript": "catalog:"
	}
}
