{
	"name": "mit-classics",
	"version": "1.0.0",
	"description": "Greco-Roman classics in public-domain English translations from The Internet Classics Archive",
	"icon": "https://classics.mit.edu/favicon.ico",
	"keywords": [
		"classics",
		"greek",
		"roman",
		"literature",
		"public domain"
	],
	"api_version": "*",
	"lang": [
		"en"
	],
	"nsfw": false,
	"url": "http://classics.mit.edu/",
	"extension_type": [
		{
			"type": "EntryProvider",
			"has_search": true
		}
	],
	"media_type": [
		"Book"
	],
	"authors": [
		"bldng1337"
	],
	"license": "ISC",
	"id": "5d7166b1-5fc5-4f3e-b4a7-4f1633f98a8a",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun test",
		"lint": "bunx biome check",
		"format": "bunx biome format --write",
		"build": "bunx dion-bundle",
		"check-types": "bunx tsc --noEmit"
	},
	"permissions": [
		{
			"type": "Network",
			"domains": [
				"classics.mit.edu"
			]
		}
	],
	"dependencies": {
		"@dion-js/runtime-lib": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@biomejs/biome": "catalog:",
		"@dion-js/runtime": "catalog:",
		"@dion-js/runtime-types": "catalog:",
		"@dion-js/extension-types": "catalog:",
		"@dion-js/config": "catalog:",
		"typescript": "catalog:",
		"@dion-js/extension-test-utils": "catalog:"
	}
}
