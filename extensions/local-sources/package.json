{
	"name": "local-sources",
	"version": "1.2.0",
	"desc": "Read and play your own local library: pick a folder and its PDFs, EPUBs, text files, MP3s and MP4s show up as entries - one per loose file, one per folder with multiple episodes - titled and illustrated from the metadata stored inside them.",
	"icon": "https://placehold.co/256x256/EEE/31343C.png?text=Local",
	"tags": [
		"local",
		"files",
		"books",
		"pdf",
		"epub",
		"text",
		"audio",
		"mp3",
		"video",
		"mp4",
		"metadata"
	],
	"api_version": "*",
	"lang": [],
	"nsfw": false,
	"url": "https://dion.local/",
	"extension_type": [
		{
			"type": "EntryProvider",
			"has_search": true
		}
	],
	"media_type": [
		"Book",
		"Audio",
		"Video"
	],
	"authors": [
		"bldng1337"
	],
	"license": "ISC",
	"id": "09b43c59-b06a-4632-8d85-0e3cd6a8af04",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun test",
		"lint": "bunx biome check",
		"format": "bunx biome format --write",
		"build": "bunx dion-bundle",
		"check-types": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@dion-js/runtime-lib": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@biomejs/biome": "catalog:",
		"@dion-js/runtime": "catalog:",
		"@dion-js/runtime-types": "catalog:",
		"@dion-js/extension-types": "catalog:",
		"@dion-js/config": "catalog:",
		"@dion-js/extension-test-utils": "catalog:",
		"typescript": "catalog:"
	}
}
