{
	"name": "alquran-cloud",
	"version": "1.0.0",
	"description": "Read and listen to the Quran — all 114 surahs in Arabic (Uthmani) with translations and recitations — via the free AlQuran.cloud JSON API.",
	"icon": "https://alquran.cloud/apple-icon.png",
	"keywords": [
		"quran",
		"islam",
		"religion",
		"scripture"
	],
	"api_version": "*",
	"lang": [
		"ar",
		"en",
		"mul"
	],
	"nsfw": false,
	"url": "https://alquran.cloud/",
	"extension_type": [
		{
			"type": "EntryProvider",
			"has_search": true
		}
	],
	"media_type": [
		"Book",
		"Audio"
	],
	"permissions": [
		{
			"type": "Network",
			"domains": [
				"api.alquran.cloud",
				"cdn.islamic.network"
			]
		}
	],
	"tags": [
		"quran",
		"islam",
		"religion",
		"scripture"
	],
	"desc": "Read and listen to the Quran — all 114 surahs in Arabic (Uthmani) with translations and recitations — via the free AlQuran.cloud JSON API.",
	"authors": [
		"bldng1337"
	],
	"license": "ISC",
	"id": "4967cd70-4f6d-4b00-aa0b-cb9bb683b220",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun test",
		"lint": "bunx biome check",
		"format": "bunx biome format --write",
		"build": "bunx dion-bundle",
		"check-types": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@dion-js/runtime-lib": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@biomejs/biome": "catalog:",
		"@dion-js/runtime": "catalog:",
		"@dion-js/runtime-types": "catalog:",
		"@dion-js/extension-types": "catalog:",
		"@dion-js/config": "catalog:",
		"typescript": "catalog:",
		"@dion-js/extension-test-utils": "catalog:"
	}
