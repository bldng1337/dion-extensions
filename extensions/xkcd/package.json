{
	"name": "xkcd",
	"version": "1.0.0",
	"description": "Browse and read xkcd, Randall Munroe's webcomic of romance, sarcasm, math, and language.",
	"desc": "Browse and read xkcd, Randall Munroe's webcomic of romance, sarcasm, math, and language.",
	"icon": "https://xkcd.com/favicon.ico",
	"keywords": [
		"xkcd",
		"webcomic",
		"comics",
		"humor"
	],
	"tags": [
		"xkcd",
		"webcomic",
		"comics",
		"humor"
	],
	"api_version": "*",
	"lang": [
		"en"
	],
	"nsfw": false,
	"url": "https://xkcd.com/",
	"extension_type": [
		{
			"type": "EntryProvider",
			"has_search": true
		}
	],
	"media_type": [
		"Comic"
	],
	"permissions": [
		{
			"type": "Network",
			"domains": [
				"xkcd.com",
				"imgs.xkcd.com"
			]
		}
	],
	"authors": [
		"bldng1337"
	],
	"license": "ISC",
	"id": "a557c131-c911-49ec-904d-27814b1458a7",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun test",
		"lint": "bunx biome check",
		"format": "bunx biome format --write",
		"build": "bunx dion-bundle",
		"check-types": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@dion-js/runtime-lib": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@biomejs/biome": "catalog:",
		"@dion-js/runtime": "catalog:",
		"@dion-js/runtime-types": "catalog:",
		"@dion-js/extension-types": "catalog:",
		"@dion-js/config": "catalog:",
		"typescript": "catalog:",
		"@dion-js/extension-test-utils": "catalog:"
	}
}
